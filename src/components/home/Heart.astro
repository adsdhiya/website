---
import dhiyaMark from "../../../public/media/dhiya-mark-ink.svg?raw";
const unifiedMark = dhiyaMark.replace(/<svg[^>]*>|<\/svg>|<title>.*?<\/title>/g, "");
const products = [
  { slug: "ayana", name: "Ayana", role: "Sell · CRM + billing", description: "Accounts, contracts, metered usage and invoices, read from the floor they cover. The CRM finally knows the capacity." },
  { slug: "neev", name: "Neev", role: "Operate · DC Ops", description: "Racks, power, cooling and capacity, with the facility work that keeps them running. Every alarm lands on the asset it came from." },
  { slug: "vitana", name: "Vitana", role: "Resolve · IT Ops", description: "Monitoring, incidents, changes and runbooks, with the rack and the customer already attached. The ticket knows the floor." },
  { slug: "aire", name: "Aire", role: "Compute · Cloud", description: "Provision, monitor and bill GPU and cloud tenants on the same record as the hall they live in." },
];
// A dotted still frame uses the same implicit 3D heart as the animated scene.
const fallbackDots = Array.from({length: 540}, (_,i) => {
  const dy = 1 - 2 * (i + .5) / 540;
  const ring = Math.sqrt(1 - dy * dy), angle = i * 2.399963229728653;
  const dx = Math.cos(angle) * ring, dz = Math.sin(angle) * ring;
  const A = dx * dx + dy * dy + 2.25 * dz * dz;
  const c = dy * Math.cbrt(dx * dx + .1125 * dz * dz);
  let lo = 0, hi = 2;
  for (let j = 0; j < 24; j++) {
    const r = (lo + hi) / 2;
    if (A * r * r - 1 - c * Math.pow(r, 5 / 3) < 0) lo = r; else hi = r;
  }
  const radius = (lo + hi) / 2;
  const x = dx * radius / 1.14, y = (dy * radius - .12) / 1.14, z = dz * radius * .93;
  const ca = Math.cos(.38), sa = Math.sin(.38), cp = Math.cos(-.10), sp = Math.sin(-.10), cr = Math.cos(.10), sr = Math.sin(.10);
  const rx = x * ca + z * sa, rz = -x * sa + z * ca;
  const ry = y * cp - rz * sp, depthZ = y * sp + rz * cp;
  const screenX = rx * cr - ry * sr, screenY = -(rx * sr + ry * cr);
  const perspective = 5 / (5 - depthZ), depth = Math.max(0, Math.min(1, (depthZ + .8) / 1.6));
  return {x:100+screenX*78*perspective,y:85+screenY*78*perspective,r:.4+depth*.36,opacity:.16+depth*.55,z:depthZ};
}).sort((a,b)=>a.z-b.z);
// The floor is atmosphere for the whole section, not an object beneath the heart.
const iso = (x: number, z: number, y = 0) => `${720 + (x-z)*.85},${440 + (x+z)*.38-y}`;
const segment = (a: string, b: string) => `M${a}L${b}`;
let floorGrid = "";
for (let x=-600;x<=600;x+=80) floorGrid += segment(iso(x,-440),iso(x,440));
for (let z=-440;z<=440;z+=80) floorGrid += segment(iso(-600,z),iso(600,z));
const floorRacks: string[] = [];
for(let row=0;row<6;row++) for(let col=0;col<10;col++) {
  if(col===4 || col===5 || row===2) continue;
  const x=-540+col*114, z=-370+row*142, w=34, d=52, h=60;
  let rack=`M${iso(x,z)}L${iso(x+w,z)}L${iso(x+w,z+d)}L${iso(x,z+d)}Z`;
  rack+=`M${iso(x,z,h)}L${iso(x+w,z,h)}L${iso(x+w,z+d,h)}L${iso(x,z+d,h)}Z`;
  [[x,z],[x+w,z],[x+w,z+d],[x,z+d]].forEach(([a,b])=>rack+=segment(iso(a,b),iso(a,b,h)));
  for(let y=12;y<h;y+=12) rack+=segment(iso(x,z,y),iso(x+w,z,y));
  floorRacks.push(rack);
}
const floorRoutes = [
  `M${iso(-540,-370)}L${iso(-540,-90)}L${iso(30,-90)}L${iso(30,340)}`,
  `M${iso(486,-370)}L${iso(486,56)}L${iso(-198,56)}L${iso(-198,340)}`
];
---
<section class="heart" id="dil" aria-labelledby="heart-title">
  <svg class="heart-floor" viewBox="0 0 1440 880" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="heart-floor-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="white" stop-opacity="0" />
        <stop offset=".2" stop-color="white" stop-opacity=".6" />
        <stop offset=".7" stop-color="white" />
        <stop offset="1" stop-color="white" stop-opacity="0" />
      </linearGradient>
      <mask id="heart-floor-mask"><rect width="1440" height="880" fill="url(#heart-floor-fade)" /></mask>
    </defs>
    <g mask="url(#heart-floor-mask)" fill="none" stroke-linejoin="round">
      <path class="floor-grid" d={floorGrid} />
      {floorRacks.map(d=><path class="floor-rack" d={d} />)}
      {floorRoutes.map((d,i)=><path class:list={["floor-route", `floor-route-${i}`]} d={d} />)}
    </g>
  </svg>
  <div class="heart-layout wrap">
  <div class="heart-copy">
    <p class="heart-eyebrow">Introducing DIL</p>
    <h2 id="heart-title">The heart of<br />the data centre.</h2>
    <p>Four products come together around one shared record. From the floor to the customer, every part of your data centre stays connected.</p>
    <a class="heart-platform" href="/dil">Explore the platform <span aria-hidden="true">↗</span></a>
    <div class="heart-detail" aria-live="polite">
      <p class="heart-detail-role">Four products. One record.</p>
      <h3 class="heart-detail-name">Connected at the core.</h3>
      <p class="heart-detail-description">Choose a product to see how it connects to DIL and your floor.</p>
      <a class="heart-detail-link" href="/dil">Discover DIL →</a>
    </div>
  </div>
  <div class="heart-scene" aria-label="Four product stars converge into the Dhiya logo, which transforms into a three-dimensional dotted heart. The products then orbit DIL, one shared record.">
    <p class="heart-hint" aria-hidden="true">Four products. One shared heartbeat.</p>
    <svg class="heart-fallback" viewBox="0 0 200 180" aria-hidden="true">
      {fallbackDots.map(dot=><circle cx={dot.x} cy={dot.y} r={dot.r} opacity={dot.opacity} />)}
    </svg>
    <canvas id="heartc" aria-hidden="true"></canvas>
    <div class="heart-unified-mark" aria-hidden="true"><svg viewBox="0 0 424 424" focusable="false" set:html={unifiedMark} /></div>
    <div class="heart-core" aria-hidden="true"><strong>DIL</strong><span>One shared record</span></div>
    <div class="heart-products" aria-label="Explore Dhiya products">
      {products.map((product, i) => (
        <button type="button" class="heart-product" data-i={i} data-name={product.name} data-role={product.role} data-description={product.description} data-href={`/${product.slug}`} aria-label={`Explore ${product.name}: ${product.role}`} aria-pressed="false">
          <img class="heart-mark" src={`/media/logos/${product.slug}-mark_on-chalk.svg`} width="56" height="56" alt="" />
          <span>{product.name}</span>
        </button>
      ))}
    </div>
    <span class="heart-record" aria-hidden="true">Every connection, kept.</span>
    <div class="heart-controls">
      <button type="button" class="heart-replay">Replay formation <span aria-hidden="true">↻</span></button>
      <button type="button" class="heart-toggle" aria-pressed="false">Pause animation</button>
    </div>
    <p class="heart-caption">Sell. Operate. Resolve. Compute.</p>
  </div>
  </div>
</section>
<style>
  .heart{position:relative;padding-block:56px;background:#F4F0F6;color:var(--ink);overflow:hidden;isolation:isolate}
  .heart-layout{position:relative;z-index:1;display:grid;grid-template-columns:minmax(280px,.85fr) minmax(0,1.5fr);align-items:center;gap:clamp(24px,4vw,64px);min-height:628px;width:100%}
  .heart-floor{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;mask-image:linear-gradient(90deg,rgba(0,0,0,.28),#000 50%);stroke-width:.85}
  .floor-grid{stroke:#837594;opacity:.12}.floor-rack{stroke:#837594;opacity:.16}
  .floor-route{stroke-width:1.1;opacity:.2}.floor-route-0{stroke:#5662A6}.floor-route-1{stroke:#AD842E}
  .heart-copy{position:relative;z-index:2;max-width:400px}
  .heart-eyebrow,.heart-hint,.heart-detail-role,.heart-record,.heart-caption{font:500 10px/1.6 var(--mono);letter-spacing:.12em;text-transform:uppercase}
  .heart-eyebrow{color:#744967;margin:0 0 16px}
  .heart h2{font:500 clamp(32px,3.5vw,54px)/1.08 var(--font);letter-spacing:-.035em;margin:0 0 22px}
  .heart-copy>p:not(.heart-eyebrow){font-size:16px;line-height:1.65;color:#654B75;max-width:35ch}
  .heart-platform,.heart-detail-link{display:inline-flex;align-items:center;gap:24px;font-size:14px;font-weight:600;text-decoration:none;color:#250B1E;padding-bottom:5px;border-bottom:1px solid #B89CC8}
  .heart-platform{margin-top:18px}
  .heart-detail{margin-top:32px;border-left:2px solid #B89CC8;padding-left:18px;min-height:170px}
  .heart-detail-role{color:#744967;margin:0 0 8px}
  .heart-detail-name{font:500 21px/1.3 var(--font);margin:0 0 10px}
  .heart-detail-description{font-size:14px;line-height:1.6;color:#654B75;max-width:35ch;margin:0 0 14px}
  .heart-detail-link{font-size:13px}
  .heart-scene{position:relative;z-index:1;height:620px;min-width:0;overflow:hidden}
  .heart-scene::before{content:"";position:absolute;inset:8% 5% 17%;background:radial-gradient(ellipse,rgba(244,240,246,.95),rgba(244,240,246,.35) 58%,transparent 73%);pointer-events:none;z-index:0}
  .heart-scene canvas{position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none}
  .heart-hint{position:absolute;top:10px;left:0;right:0;max-width:none;text-align:center;color:#765E80;margin:0;z-index:6;pointer-events:none}
  .heart-product{--heart-mark-size:48px;position:absolute;left:50%;top:46%;display:flex;flex-direction:column;align-items:center;gap:6px;padding:6px;min-width:72px;min-height:72px;border:0;border-radius:6px;background:transparent!important;box-shadow:none!important;color:#342238;cursor:pointer;transform:translate(-50%,-50%);transition:color .2s;z-index:3;-webkit-tap-highlight-color:transparent}
  .heart-product:nth-child(1){left:20%;top:25%}.heart-product:nth-child(2){left:80%;top:25%}.heart-product:nth-child(3){left:20%;top:67%}.heart-product:nth-child(4){left:80%;top:67%}
  .heart-product .heart-mark{display:block;width:var(--heart-mark-size);height:var(--heart-mark-size);overflow:visible;transition:transform .2s}
  .heart-product span{position:absolute;top:calc(50% + var(--heart-mark-size)/2 + 6px);left:50%;transform:translateX(-50%);font:500 13px var(--font);text-shadow:0 1px 8px #F4F0F6,0 0 4px #F4F0F6;white-space:nowrap}
  .heart[data-heart-ready][data-visible="true"]:not([data-paused="true"]) .heart-product{will-change:transform}
  .heart-product:hover .heart-mark,.heart-product[aria-pressed="true"] .heart-mark{transform:scale(1.12)}
  .heart-product:hover,.heart-product[aria-pressed="true"]{color:#250B1E}
  .heart-product:focus-visible{outline:2px solid #654B75;outline-offset:3px}
  .heart-unified-mark{position:absolute;left:50%;top:46%;width:132px;transform:translate(-50%,-50%);opacity:0;pointer-events:none;z-index:4}.heart-unified-mark svg{display:block;width:100%;height:auto;overflow:visible}
  .heart-core{position:absolute;left:50%;top:46%;display:flex;align-items:center;flex-direction:column;gap:3px;transform:translate(-50%,-50%);color:#250B1E;text-shadow:0 0 12px #F4F0F6,0 0 6px #F4F0F6;pointer-events:none;z-index:4}
  .heart-core strong{font:500 clamp(32px,3.4vw,48px)/1 var(--font);letter-spacing:-.055em}
  .heart-core span{font:500 9px/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#765E80;white-space:nowrap}
  .heart-record{position:absolute;top:79%;left:0;right:0;text-align:center;color:#744967;pointer-events:none;font-size:10px;z-index:6}
  .heart-caption{position:absolute;left:0;right:0;bottom:0;max-width:none;margin:0;text-align:center;color:#765E80;font-size:9px}
  .heart-controls{position:absolute;left:0;right:0;bottom:36px;display:flex;justify-content:center;gap:20px;z-index:6}
  .heart-controls button{background:none;border:0;padding:8px 0;min-height:32px;color:#6B5575;font:400 11px var(--font);cursor:pointer;border-bottom:1px solid #CFC2D7}
  .heart-controls button:hover{color:#250B1E;border-color:#765E80}
  .heart-controls button:focus-visible{outline:2px solid #654B75;outline-offset:4px;border-radius:3px}
  .heart-controls button:disabled{cursor:default;opacity:.5}
  .heart-replay span{margin-left:5px}
  .heart-fallback{position:absolute;left:50%;top:46%;width:56%;max-height:58%;transform:translate(-50%,-50%);fill:#654B75;stroke:none}
  .heart[data-heart-ready] .heart-fallback{display:none}
  .heart:not([data-heart-ready]) .heart-controls{display:none}
  @media(max-width:1000px){.heart-layout{grid-template-columns:minmax(250px,.9fr) minmax(0,1.2fr);gap:24px;min-height:568px}.heart-scene{height:560px}.heart-product{--heart-mark-size:44px}.heart-product span{font-size:12px}.heart-core strong{font-size:35px}.heart-core span{font-size:8px}}
  @media(max-width:760px){.heart{padding-block:48px 36px}.heart-layout{display:flex;flex-direction:column;align-items:stretch;gap:28px;min-height:0}.heart-copy{max-width:100%}.heart h2{font-size:38px}.heart-copy>p:not(.heart-eyebrow){max-width:48ch}.heart-detail{min-height:0;margin-top:26px}.heart-scene{height:460px;width:100%;max-width:600px;align-self:center}.heart-hint{top:0;font-size:9px}.heart-product{min-width:62px;min-height:64px}.heart-product{--heart-mark-size:40px}.heart-record{font-size:9px}.heart-floor{mask-image:linear-gradient(180deg,transparent 0%,rgba(0,0,0,.5) 35%,#000 100%)}.heart-core strong{font-size:34px}.heart-core span{font-size:7px}}
  @media(max-width:360px){.heart-product{min-width:55px;padding:3px}.heart-product{--heart-mark-size:36px}.heart-product span{font-size:11px}.heart-core strong{font-size:30px}.heart-core span{font-size:6.5px}}
  @media(prefers-reduced-motion:reduce){.heart-product .heart-mark{transition:none}.heart[data-heart-ready] .heart-product{will-change:auto}}
</style>
<script is:inline src="/js/heart-volume.js"></script>
<script is:inline src="/js/heart.js"></script>
