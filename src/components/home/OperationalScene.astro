---
interface Props { mode: number }
const { mode } = Astro.props;
const accents = ['#B03729', '#198AA2', '#198AA2', '#315ADE', '#41657A'];
const accent = accents[mode];
const racks = Array.from({ length: 18 }, (_, i) => ({ x: 70 + (i % 6) * 60, y: 80 + Math.floor(i / 6) * 56, i }));
---
<svg class="operational-scene" viewBox="0 0 500 320" aria-hidden="true" style={`--scene-accent:${accent}`}>
  <defs>
    <pattern id={`floor-${mode}`} width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="#B89CC8" stroke-opacity=".16" /></pattern>
  </defs>
  <rect width="500" height="320" fill="#F7F0ED" />
  <rect x="20" y="20" width="460" height="280" rx="20" fill={`url(#floor-${mode})`} />
  {mode < 3 && <>
    <path d="M45 58H455V266H45Z M45 132H455 M45 190H455" fill="none" stroke="#B89CC8" stroke-width="1.5" />
    {racks.map(({x,y,i}) => <g>
      <rect x={x} y={y} width="36" height="30" rx="5" fill={mode === 0 && i > 11 ? '#F6E7E5' : '#E9DFEF'} stroke={mode === 0 && i > 11 ? accent : '#B89CC8'} stroke-dasharray={mode === 1 && i > 11 ? '3 3' : undefined} />
      <path d={`M${x+7} ${y+10}h22m-22 5h22m-22 5h14`} stroke={accent} stroke-opacity={mode === 1 && i > 11 ? '.2' : '.5'} fill="none" />
    </g>)}
    <text x="45" y="43">{mode === 1 ? 'PHASE B · COMMISSIONING' : 'HALL 2 · FLOOR PLAN'}</text>
    <text x="25" y="101">A</text><text x="25" y="157">B</text><text x="25" y="213">C</text>
  </>}
  {mode === 0 && <>
    <path class="scene-flow" d="M86 238H405" stroke={accent} stroke-width="3" stroke-dasharray="6 6" />
    <rect x="282" y="278" width="164" height="24" rx="12" fill="#F6E7E5" />
    <text x="298" y="294" fill={accent}>400 kW AVAILABLE</text>
    <text x="54" y="294">POWER + SPACE + COOLING</text>
  </>}
  {mode === 1 && <>
    <path d="M86 246H405" stroke="#C8B1D6" stroke-width="2" />
    {[86,192,298,405].map((x,i) => <g><circle cx={x} cy="246" r="7" fill={i<3?accent:'#F7F0ED'} stroke={accent}/><text x={x} y="285" text-anchor="middle">{['BUILD','TEST','SIGN OFF','GO LIVE'][i]}</text></g>)}
  </>}
  {mode === 2 && <>
    <rect x="374" y="191" width="36" height="33" rx="5" fill="#F6E7E5" stroke="#B03729" stroke-width="2" />
    <path class="scene-flow" d="M70 236H390V218" fill="none" stroke="#198AA2" stroke-width="3" stroke-dasharray="6 6" />
    <text x="54" y="289">ROW C · COOLING LOOP</text><text x="291" y="289" fill="#B03729">CRAH-07 · +1.8°C</text>
  </>}
  {mode === 3 && <>
    <text x="40" y="43">CORRELATE · ONE CAUSE, ONE INCIDENT</text>
    {Array.from({length:8},(_,i)=><g><circle cx={60+(i%2)*55} cy={80+Math.floor(i/2)*48} r="13" fill="#F6E7E5" stroke="#B03729"/><path d={`M${73+(i%2)*55} ${80+Math.floor(i/2)*48}L260 155`} stroke="#B89CC8" fill="none"/></g>)}
    <rect x="240" y="118" width="200" height="76" rx="18" fill="#E6EBFB" stroke={accent}/>
    <text x="340" y="145" text-anchor="middle" fill={accent}>INC-2041</text>
    <text x="340" y="174" text-anchor="middle" class="scene-number">40 → 1</text>
    <path class="scene-flow" d="M340 194V246H425" fill="none" stroke={accent} stroke-width="2" stroke-dasharray="5 5"/>
    <text x="40" y="286">ALARMS LINKED TO THEIR RACK + POWER PATH</text>
  </>}
  {mode === 4 && <>
    <text x="40" y="43">RACK 2B-14 · GPU TELEMETRY</text>
    <rect x="50" y="68" width="134" height="211" rx="14" fill="#E9DFEF" stroke="#B89CC8"/>
    {Array.from({length:8},(_,i)=><g><rect x="64" y={82+i*23} width="106" height="16" rx="4" fill="#F7F0ED" stroke="#B89CC8"/><circle cx="153" cy={90+i*23} r="2.5" fill={i>4?'#B03729':accent}/></g>)}
    <text x="220" y="93">GPU INLET TEMPERATURE</text>
    <path d="M220 162H447M220 122H447" stroke="#DCCDE3"/>
    <path d="M220 157L247 153L269 160L291 140L315 144L340 121L363 126L391 100L419 96L447 79" fill="none" stroke="#B03729" stroke-width="3" stroke-linejoin="round"/>
    <text x="220" y="212" class="scene-number">38 kW</text><text x="220" y="238">RACK POWER DRAW</text>
    <text x="220" y="276" fill="#B03729">THERMAL DRIFT DETECTED</text>
  </>}
</svg>
<style>
  .operational-scene{display:block;width:100%;height:100%}
  text{font:500 9px var(--mono);letter-spacing:.05em;fill:#654B75}.scene-number{font-size:26px;letter-spacing:-.04em;fill:var(--scene-accent)}
  .scene-flow{animation:scene-flow 5s linear infinite}@keyframes scene-flow{to{stroke-dashoffset:-60}}
  @media(prefers-reduced-motion:reduce){.scene-flow{animation:none}}
</style>
