---
import { site } from "../data/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const cur = (href: string) => !href.includes("#") && href === path ? "page" : undefined;
const groups = [["Platform", site.nav.platform], ["Product", site.nav.product], ["Company", site.nav.company]] as const;
---
<nav class="nav site-nav" aria-label="Main" data-site-navigation data-nav-tone="light">
  <a class="nav-brand" href="/" aria-label="Dhiya home"><img class="nav-logo-light" src="/media/dhiya-lockup.svg" alt="" width="116" height="30"><img class="nav-logo-dark" src="/media/dhiya-lockup-ink.svg" alt="" width="116" height="30" aria-hidden="true"></a>
  <ul id="primary-navigation">
    {groups.map(([name, items]) => (
      <li><details class="dd"><summary>{name}</summary><div class="menu">
        {items.map((it) => (<a href={it.href} aria-current={cur(it.href)}><span class="nav-menu-title">{"img" in it && it.img ? <img src={it.img} alt="" /> : null}<span>{it.label}</span></span><small>{it.sub}</small></a>))}
      </div></details></li>
    ))}
    <li class="mobile-contact"><a href="#talk">Talk to us <span aria-hidden="true">→</span></a></li>
  </ul>
  <button class="burger" type="button" aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="false"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i></button>
  <a class="btn nav-contact" href="#talk">Talk to us <span aria-hidden="true">→</span></a>
</nav>
<style>
  /* The backdrop is the actual painted page, including cards, images and gradients. */
  :global(.site-header:has(>.site-nav.nav)){height:72px;padding:0;pointer-events:auto}
  :global(.site-header-home:has(>.site-nav.nav)){margin-bottom:-72px}
  .site-nav.nav{--nav-solid-background:#fff;--nav-ink:#250B1E;--nav-muted:#654B75;--nav-line:rgba(37,11,30,.14);--nav-hover:rgba(37,11,30,.045);--nav-cta:#250B1E;--nav-cta-ink:#FFF9FE;--nav-cta-hover:#3C1B35;--nav-focus:#654B75;position:relative;z-index:30;display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:24px;width:100%;max-width:none;min-height:72px;margin:0;padding-block:0;padding-inline:max(24px,env(safe-area-inset-left,0px),4vw) max(24px,env(safe-area-inset-right,0px),4vw);border:0;border-bottom:1px solid transparent;border-radius:0;background:transparent;color:var(--nav-ink);box-shadow:none;isolation:isolate;transition:color .24s ease,border-color .24s ease}
  .site-nav.nav::before{content:"";position:absolute;inset:0 0 -24px;z-index:-1;pointer-events:none;background:transparent;-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);-webkit-mask-image:linear-gradient(#000 0,#000 calc(100% - 26px),transparent 100%);mask-image:linear-gradient(#000 0,#000 calc(100% - 26px),transparent 100%)}
  .site-nav.nav[data-nav-contrast="strong"][data-nav-tone="light"]{--nav-ink:#000}
  .site-nav.nav[data-nav-contrast="strong"][data-nav-tone="dark"]{--nav-ink:#fff}
  .site-nav.nav[data-nav-tone="dark"]{--nav-ink:#F7F0ED;--nav-muted:#CAB8D2;--nav-line:rgba(247,240,237,.18);--nav-hover:rgba(247,240,237,.07);--nav-cta:#B89CC8;--nav-cta-ink:#250B1E;--nav-cta-hover:#D0B9DD;--nav-focus:#D9C3E4}
  .site-nav.nav.open,.site-nav.nav.has-dropdown{border-bottom-color:var(--nav-line)}
  .site-nav .nav-brand{display:grid;justify-self:start;min-width:0;text-decoration:none}
  .site-nav .nav-brand img{grid-area:1/1;width:116px;height:30px;object-fit:contain;transition:opacity .24s ease}
  .site-nav .nav-brand .nav-logo-dark{opacity:0}
  .site-nav[data-nav-tone="dark"] .nav-brand .nav-logo-light{opacity:0}
  .site-nav[data-nav-tone="dark"] .nav-brand .nav-logo-dark{opacity:1}
  .site-nav.nav>ul{display:flex;flex-wrap:nowrap;flex-direction:row;align-items:center;justify-self:center;gap:14px;margin:0;padding:0;border:0;background:transparent;list-style:none;font:500 14px/1.4 var(--font);order:0}
  .site-nav .dd summary{min-height:44px;gap:9px;padding:10px 12px;border-radius:6px;color:var(--nav-ink)}
  .site-nav .dd summary:hover,.site-nav .dd[open] summary{background:var(--nav-hover)}
  .site-nav .dd summary::after{width:5px;height:5px;opacity:.65}
  .site-nav.nav>.nav-contact{justify-self:end;min-height:40px;padding:0 21px;gap:12px;border-radius:6px;font:500 14px/1.4 var(--font);white-space:nowrap;background:var(--nav-cta);border:1px solid var(--nav-cta);color:var(--nav-cta-ink)}
  .site-nav.nav>.nav-contact:hover{background:var(--nav-cta-hover);border-color:var(--nav-cta-hover)}
  .site-nav .dd .menu{top:calc(100% + 14px);left:50%;min-width:270px;padding:8px;transform:translateX(-50%);border:1px solid var(--nav-line);border-radius:6px;background:var(--nav-solid-background);box-shadow:0 16px 40px rgba(37,11,30,.1)}
  .site-nav .dd .menu a{padding:11px 13px;gap:5px;border-radius:4px;color:var(--nav-ink);text-decoration:none}
  .site-nav .dd .menu a:hover,.site-nav .dd .menu a[aria-current="page"]{background:var(--nav-hover)}
  .site-nav .nav-menu-title{display:flex;align-items:center;gap:8px;font-weight:500}
  .site-nav .dd .menu a img{display:block;flex:none;width:20px;height:20px;margin:0}
  .site-nav .dd .menu a small{font:400 12px/1.45 var(--font);color:var(--nav-muted)}
  .site-nav .mobile-contact{display:none}
  .site-nav .burger{display:none}
  .site-nav a:focus-visible,.site-nav summary:focus-visible,.site-nav button:focus-visible{outline:2px solid var(--nav-focus);outline-offset:3px}
  @media(max-width:1000px) and (min-width:761px){.site-nav.nav{gap:14px;padding-inline:max(24px,env(safe-area-inset-left,0px)) max(24px,env(safe-area-inset-right,0px))}.site-nav.nav>ul{gap:3px}.site-nav .dd summary{padding-inline:10px}.site-nav.nav>.nav-contact{padding-inline:17px}}
  @media(max-width:760px){
    :global(.site-header:has(>.site-nav.nav)){height:64px}
    :global(.site-header-home:has(>.site-nav.nav)){margin-bottom:-64px}
    .site-nav.nav{min-height:64px;grid-template-columns:minmax(0,1fr) auto;gap:12px;padding-inline:max(20px,env(safe-area-inset-left,0px)) max(20px,env(safe-area-inset-right,0px))}
    .site-nav .nav-brand img{width:108px;height:28px}
    .site-nav.nav>.nav-contact{display:none}
    .site-nav .burger{display:flex;justify-self:end;order:0;margin:0;width:40px;height:40px;border:1px solid var(--nav-line);border-radius:6px;gap:4px;background:transparent}
    .site-nav .burger i{width:17px;height:1.5px;background:var(--nav-ink);transition:transform .18s,opacity .18s}
    .site-nav.open .burger i:first-child{transform:translateY(5.5px) rotate(45deg)}
    .site-nav.open .burger i:nth-child(2){opacity:0}
    .site-nav.open .burger i:last-child{transform:translateY(-5.5px) rotate(-45deg)}
    .site-nav.nav>ul{display:none;position:absolute;left:0;right:0;top:100%;width:100%;max-height:calc(100svh - 110px);overflow:auto;overscroll-behavior:contain;flex-direction:column;align-items:stretch;gap:2px;justify-self:stretch;padding-block:10px 18px;padding-inline:max(20px,env(safe-area-inset-left,0px)) max(20px,env(safe-area-inset-right,0px));border:0;border-bottom:1px solid var(--nav-line);border-radius:0;background:var(--nav-solid-background);box-shadow:0 16px 24px rgba(37,11,30,.06)}
    .site-nav.nav.open>ul{display:flex}
    .site-nav .dd summary{justify-content:space-between;min-height:46px;padding:12px 4px;border-radius:0}
    .site-nav .dd summary:hover,.site-nav .dd[open] summary{background:transparent}
    .site-nav .dd .menu{position:static;min-width:0;transform:none;padding:2px 0 10px 8px;border:0;border-left:1px solid var(--nav-line);border-radius:0;box-shadow:none}
    .site-nav .dd .menu a{padding:10px 12px}
    .site-nav .mobile-contact{display:block;border-top:1px solid var(--nav-line);margin-top:8px;padding:14px 0 0}
    .site-nav .mobile-contact a{display:inline-flex;align-items:center;gap:14px;min-height:42px;padding:0 18px;border-radius:6px;background:var(--nav-cta);color:var(--nav-cta-ink);font-weight:500}
  }
  @supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.site-nav.nav::before{background:rgba(255,255,255,.92)}.site-nav.nav[data-nav-tone="dark"]::before{background:rgba(37,11,30,.92)}}
  @media(prefers-reduced-motion:reduce){.site-nav.nav,.site-nav .nav-brand img,.site-nav .burger i,.site-nav .dd summary::after{transition:none}}
</style>
<script is:inline>
(function () {
  var nav = document.querySelector('[data-site-navigation]');
  if (!nav || nav.dataset.navReady === 'true') return;
  nav.dataset.navReady = 'true';
  var groups = Array.from(nav.querySelectorAll('.dd'));
  var burger = nav.querySelector('.burger');
  function updateSurface() {
    nav.classList.toggle('has-dropdown', groups.some(function (group) { return group.open; }));
  }
  function closeDropdowns(except) {
    groups.forEach(function (group) { if (group !== except) group.open = false; });
    updateSurface();
  }
  function setMobile(open) {
    nav.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    if (!open) closeDropdowns();
  }
  groups.forEach(function (group) {
    group.addEventListener('toggle', function () {
      if (group.open) closeDropdowns(group);
      updateSurface();
    });
  });
  burger.addEventListener('click', function () { setMobile(!nav.classList.contains('open')); });
  nav.addEventListener('click', function (event) {
    if (event.target.closest('a')) setMobile(false);
  });
  nav.addEventListener('focusout', function (event) {
    if (event.relatedTarget && !nav.contains(event.relatedTarget)) setMobile(false);
  });
  document.addEventListener('click', function (event) {
    if (!nav.contains(event.target)) setMobile(false);
  });
  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    var openGroup = groups.find(function (group) { return group.open; });
    var mobileOpen = nav.classList.contains('open');
    if (!openGroup && !mobileOpen) return;
    event.preventDefault();
    setMobile(false);
    if (mobileOpen) burger.focus();
    else if (openGroup) openGroup.querySelector('summary').focus();
  });
  var mobileQuery = window.matchMedia('(max-width:760px)');
  function onViewportChange() { setMobile(false); }
  if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', onViewportChange);
  else mobileQuery.addListener(onViewportChange);
})();
</script>

<script is:inline src="/js/nav-theme.js" defer></script>
