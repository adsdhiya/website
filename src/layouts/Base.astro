---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Announcement from "../components/Announcement.astro";
import LaunchCeremony from "../components/LaunchCeremony.astro";
import { site } from "../data/site";
interface Props { title: string; description: string; path: string; kind?: "WebSite" | "SoftwareApplication" | "AboutPage" | "WebPage"; product?: string; dataP?: string; noNav?: boolean; noAnnounce?: boolean }
const { title, description, path, kind = "WebSite", product, dataP, noNav = false, noAnnounce = false } = Astro.props;
const url = site.url + (path === "/" ? "/" : path);
const ld: any[] = [];
if (path === "/") {
  ld.push({ "@context": "https://schema.org", "@type": "Organization", name: site.name, url: site.url + "/", logo: site.url + "/media/dhiya-mark-ink.svg", description, contactPoint: { "@type": "ContactPoint", contactType: "sales", email: site.mail } });
  ld.push({ "@context": "https://schema.org", "@type": "WebSite", name: site.name, url: site.url + "/" });
} else if (kind === "SoftwareApplication") {
  ld.push({ "@context": "https://schema.org", "@type": "SoftwareApplication", name: product, applicationCategory: "BusinessApplication", operatingSystem: "Web", url, description, publisher: { "@type": "Organization", name: site.name, url: site.url + "/" }, offers: { "@type": "Offer", availability: "https://schema.org/PreOrder", description: "Design partner programme" } });
} else {
  ld.push({ "@context": "https://schema.org", "@type": kind === "WebPage" ? "WebPage" : "AboutPage", name: title, url, description, about: { "@type": "Organization", name: site.name, url: site.url + "/" } });
}
ld.push({ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: site.url + "/" }, ...(path !== "/" ? [{ "@type": "ListItem", position: 2, name: title.split(" · ")[0].split(" |")[0], item: url }] : [])] });
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta name="robots" content="index,follow,max-image-preview:large">
<meta name="theme-color" content="#FFFFFF">
<link rel="icon" href="/media/dhiya-mark-ink.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/media/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<meta property="og:type" content="website"><meta property="og:site_name" content={site.name}><meta property="og:locale" content="en_GB">
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={url}>
<meta property="og:image" content={site.url + "/media/og-image.png"}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="Dhiya Labs · Data centre operations that work as one">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={title}><meta name="twitter:description" content={description}><meta name="twitter:image" content={site.url + "/media/og-image.png"}>
{ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
<slot name="head" />
</head>
<body data-p={dataP}>
{path === "/" && <LaunchCeremony />}
{!noAnnounce && <Announcement announcement={site.announcement} />}
{!noNav && <header class:list={["site-header", { "site-header-home": path === "/" }]}><Nav /></header>}
<slot />
<div class="footer-ground"><Footer /></div>
<script is:inline src="/forms.js"></script>
<script is:inline src="/js/motion-lifecycle.js"></script>
</body>
</html>
<style>
  .site-header{position:sticky;top:0;z-index:60;display:flow-root;height:80px;padding:12px 0;pointer-events:none}
  .site-header :global(.site-nav.nav){margin:0 auto;pointer-events:auto}
  .site-header-home{margin-bottom:-80px}
</style>
